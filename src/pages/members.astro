---
import Layout from "@layouts/Layout.astro";
import PageHero from "@components/PageHero.astro";
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";

const content = await getCollection("team");

const secretaries = content.filter((entry) => entry.data.post == "Secretary");
const members = content.filter((entry) => entry.data.post != "Secretary");
---

<Layout>
  <PageHero heading="Members">
    Meet the passionate individuals who drive our literary community forward.
    From seasoned orators to emerging writers, each member brings unique
    perspectives and talents to our society.
  </PageHero>

  <div
    class="mx-auto flex flex-col items-center gap-16 text-center text-balance md:w-5/6"
  >
    <section class="contents">
      <h2 class="text-5xl font-bold dark:text-white">Secretaries</h2>
      <div class="grid w-5/6 grid-cols-1 gap-6 sm:grid-cols-2">
        {
          secretaries.map(({ data: { image, name, quote } }) => (
            <div class="flex flex-col items-center">
              <Picture
                src={image}
                class="box-content size-56 rounded-full border-4 border-neutral-200 object-cover dark:border-neutral-400"
                alt={name}
              />
              <div class="mt-auto flex w-2/3 flex-col items-center gap-4 py-4 sm:w-3/4">
                <p class="font-serif text-xl font-light italic">
                  &ldquo;{quote}&rdquo;
                </p>
                <div class="border-t border-t-neutral-400 pt-4 dark:border-t-neutral-500">
                  <p class="font-medium">{name}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="contents">
      <h2 class="text-5xl font-bold dark:text-white">Core Members</h2>
      <div class="flex flex-wrap justify-center gap-y-12">
        {
          members.map(({ data: { image, name, quote, post } }) => (
            <div class="flex w-full flex-col items-center px-4 sm:w-1/2 lg:w-1/3">
              <Picture
                src={image}
                class="box-content size-48 rounded-full border-4 border-neutral-200 object-cover object-top dark:border-neutral-400"
                alt={name}
              />
              <div class="mt-auto flex w-2/3 flex-col items-center gap-4 py-4 sm:w-full">
                <p class="font-serif text-xl font-light italic">
                  &ldquo;{quote}&rdquo;
                </p>
                <div class="border-t border-t-neutral-400 pt-4 dark:border-t-neutral-500">
                  <p class="font-medium">{name}</p>
                  <p class="text-secondary-600 dark:text-secondary-400 text-sm">
                    {post}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
