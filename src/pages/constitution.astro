---
import Layout from "@layouts/Layout.astro";
import FileCard from "@components/constitution/FileCard.astro";
import PageHero from "@components/PageHero.astro";
import Constitution from "@components/constitution/Constitution.astro";
import ContactCard from "@components/constitution/ContactCard.astro";
---

<Layout
  title="GOALS Constitution"
  description="View the constitution of General Oratory and Literary Society, IIT Bhilai"
>
  <PageHero heading="GOALS Constitution">
    The foundational document that governs our society, outlining our mission,
    structure, and principles that guide our literary and oratory endeavors.
  </PageHero>
  <FileCard />
  <Constitution />
  <ContactCard />
</Layout>
