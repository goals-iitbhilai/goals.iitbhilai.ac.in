---
import Layout from "@layouts/Layout.astro";
import FileCard from "@components/routes/constitution/FileCard.astro";
import PageHero from "@components/PageHero.astro";
import ContactCard from "@components/routes/constitution/ContactCard.astro";

import { Content } from "../../content/constitution.md";
---

<Layout>
  <PageHero heading="GOALS Constitution">
    The foundational document that governs our society, outlining our mission,
    structure, and principles that guide our literary and oratory endeavors.
  </PageHero>

  <div class="mx-auto flex max-w-[75ch] flex-col items-center gap-16 px-8">
    <FileCard />

    <section class="prose dark:prose-invert">
      <Content />
    </section>

    <ContactCard />
  </div>
</Layout>

<style is:global>
  ol {
    list-style-type: upper-roman;
  }

  h3 {
    text-align: center;
  }
</style>
