---
import Layout from "@layouts/Layout.astro";
import Highlights from "@components/routes/about/Highlights.astro";
import WhatWeDo from "@components/routes/about/WhatWeDo.astro";
import Divisions from "@components/routes/about/Divisions.astro";
import Values from "@components/routes/about/Values.astro";
import PageHero from "@components/PageHero.astro";
---

<Layout
  title="GOALS About"
  description="Learn about the General Oratory and Literary Society, IIT Bhilai"
>
  <PageHero heading="About GOALS">
    The General Oratory & Literary Society has been fostering intellectual
    discourse, literary appreciation, and eloquent expression in our academic
    community.
  </PageHero>

  <div class="flex flex-col items-center gap-16 p-8">
    <Highlights />
    <WhatWeDo />
    <Divisions />
    <Values />
  </div>
</Layout>
