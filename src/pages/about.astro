---
import Layout from "@layouts/Layout.astro";
import Card from "@components/Card.astro";
import PrimaryIcon from "@components/PrimaryIcon.astro";
import PageHero from "@components/PageHero.astro";

const highlights = [
  {
    title: "Our Mission",
    icon: "lucide:target",
    description:
      "To cultivate eloquence, critical thinking, and literary appreciation among students" +
      " through engaging discussions, workshops, and public speaking opportunities. We strive" +
      " to create an environment of avid writers.",
  },
  {
    title: "Our History",
    icon: "lucide:history",
    description:
      "Founded on March 28, 2019, GOALS has been a cornerstone of intellectual life on campus." +
      " Our society has nurtured countless writers, speakers, and thought leaders. Cultivated a" +
      " vibrant campus atmosphere be it cultural events, MERAZ (Annual Techno-Cultural fest" +
      " of IIT Bhilai) or Guest lectures.",
  },
];

const activities = [
  {
    title: "Weekly Meetings",
    icon: "lucide:users",
    description:
      "Regular gatherings featuring literary discussions, fun games, guest speakers and presentations.",
  },
  {
    title: "Competitions",
    icon: "lucide:medal",
    description:
      "Annual poetry contests, debate tournaments, and writing competitions open to all students.",
  },
  {
    title: "Events",
    icon: "lucide:calendar",
    description:
      "MUN debate competitions in MERAZ, MOC of annual college events, Anubhuti - Poetry fest, .",
  },
];

const divisions = [
  {
    title: "DebSoc",
    emoji: "🎤",
    description:
      "Where ideas collide and transform. Every debate is less about winning and" +
      " more about shaping thought, sharpening voice, and discovering new ways to" +
      " see the world.",
  },
  {
    title: "LitSoc",
    emoji: "✒️",
    description:
      "A haven for dreamers, poets, storytellers. Here, every line you write- whether" +
      " whispered or thunderous- finds a home, an echo, a listener.",
  },
  {
    title: "WordSoc",
    emoji: "🧩",
    description:
      "The playground of language. Crosswords, riddles, scrabble - where wit meets fun," +
      " and where words sometimes surprise you more than people do.",
  },
  {
    title: "QuipSoc",
    emoji: "😏",
    description:
      "The art of thinking on your feet. Anchors, stand-up comics, emcees—this is where " +
      "wit sharpens, timing lands, and the stage becomes yours.",
  },
];

const values = [
  {
    title: "Intellectual Curiosity",
    description:
      "We encourage questioning, exploration, and the pursuit of knowledge across all literary forms and traditions.",
  },
  {
    title: "Inclusive Excellence",
    description:
      "We celebrate diverse perspectives and create space for all voices to be heard and valued.",
  },
  {
    title: "Collaborative Growth",
    description:
      "Through peer feedback and mentorship, we support each member's development as writers and speakers.",
  },
  {
    title: "Ethical Discourse",
    description:
      "We maintain high standards of respectful dialogue and critical thinking in all our activities.",
  },
];
---

<Layout>
  <PageHero heading="About GOALS">
    The General Oratory & Literary Society has been fostering intellectual
    discourse, literary appreciation, and eloquent expression in our academic
    community.
  </PageHero>

  <div class="flex flex-col items-center gap-16 p-8">
    <!-- Highlights -->
    <section class="grid grid-cols-1 gap-8 md:w-216 md:grid-cols-2">
      {
        highlights.map(({ title, icon, description }) => (
          <Card outlined={true} class="p-8">
            <div class="mb-4 flex items-center gap-4">
              <PrimaryIcon name={icon} />
              <h3 class="">{title}</h3>
            </div>
            <p class="max-w-prose">{description}</p>
          </Card>
        ))
      }
    </section>

    <!-- Activities -->
    <section class="contents">
      <h2>What We Do</h2>
      <ul class="grid grid-cols-1 gap-8 lg:grid-cols-3">
        {
          activities.map(({ title, icon, description }) => (
            <Card as="li" class="p-8 lg:w-72">
              <div class="mb-4 flex items-center gap-4">
                <PrimaryIcon name={icon} />
                <h3 class="">{title}</h3>
              </div>
              <p class="max-w-prose">{description}</p>
            </Card>
          ))
        }
      </ul>
    </section>

    <!-- Divisions -->
    <section class="contents">
      <h2>Divisions of GOALS</h2>
      <ul class="grid grid-cols-1 gap-12 px-4 md:grid-cols-2">
        {
          divisions.map(({ title, emoji, description }) => (
            <li class="md:w-96">
              <h3 class="mb-3">
                {emoji} &nbsp;{title}
              </h3>
              <p class="max-w-prose">{description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Values -->
    <section class="contents">
      <h2>Our Values</h2>
      <ul class="grid grid-cols-1 gap-8 px-4">
        {
          values.map(({ title, description }) => (
            <li>
              <h3 class="mb-2 flex items-baseline gap-3">
                <PrimaryIcon name="mdi:star" size={4} />
                {title}
              </h3>
              <p class="max-w-prose">{description}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>

<style>
  @reference "../global.css";

  h2 {
    /* Sub-headings */
    @apply text-center text-4xl font-bold text-neutral-800 dark:text-neutral-200;
  }

  h3 {
    /* Card headings */
    @apply text-2xl text-black dark:text-white;
  }
</style>
