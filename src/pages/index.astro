---
import Layout from "@layouts/Layout.astro";
import LinkButton from "@components/LinkButton.astro";
import SmallCard from "@components/SmallCard.astro";
import backgroundImg from "@assets/background.jpg";
import { getImage } from "astro:assets";
import { ChevronRight, Mic, LibraryBig, Users, Award } from "@lucide/astro";

const backgroundSrc = await getImage({ src: backgroundImg });

const aboutContent = [
  {
    icon: Mic,
    iconStyles:
      "bg-blue-100 stroke-blue-500 dark:bg-blue-700 dark:stroke-blue-300",
    heading: "Public Speaking",
    description:
      "Develop confidence and eloquence through anchoring in college " +
      "events or performing stand-up in events like Kavita, Meraz, Ciao, and Cultscape.",
  },
  {
    icon: LibraryBig,
    iconStyles:
      "bg-yellow-100 stroke-yellow-500 dark:bg-yellow-600 dark:stroke-yellow-300",
    heading: "Literary Analysis",
    description:
      "Dive into literary works through guided discussions and get " +
      "access to GOALS' exclusive library with a curated collection.",
  },
  {
    icon: Users,
    iconStyles:
      "bg-green-100 stroke-green-500 dark:bg-green-600 dark:stroke-green-300",
    heading: "Community",
    description:
      "Connect with like-minded individuals who share your passion for words and ideas.",
  },
  {
    icon: Award,
    iconStyles: "bg-red-100 stroke-red-500 dark:bg-red-800 dark:stroke-red-300",
    heading: "Competitions",
    description:
      "Participate in inter-collegiate debates, Inter IIT Cultural Meet, " +
      "Anubhuti, and writing competitions.",
  },
];
---

<Layout>
  <main class="relative flex h-[75vh] w-full items-center justify-center">
    <div
      class="absolute inset-0 -z-10 bg-cover bg-center"
      style={{ backgroundImage: `url(${backgroundSrc.src})` }}
    >
      <div
        class="dark:bg-primary-400/80 bg-secondary-700/80 absolute inset-0 z-[-9]"
      >
      </div>
    </div>
    <div
      class="flex flex-col items-center gap-4 text-center text-neutral-50 dark:text-neutral-950"
    >
      <img src="/favicon.svg" alt="Logo" class="size-20" />
      <h1 class="text-7xl">General Oratory & <br />Literary Society</h1>
      <h2 class="text-5xl font-light">IIT Bhilai</h2>
      <p class="mt-6 max-w-prose text-2xl font-extralight">
        Where eloquent voices meet literary minds. Join our community of
        speakers, writers, and critical thinkers shaping tomorrow's discourse.
      </p>
      <div class="mt-6 flex gap-8">
        <LinkButton href="/members">Meet our Team</LinkButton>
        <LinkButton href="/about" class="flex items-center gap-2">
          Learn More
          <ChevronRight />
        </LinkButton>
      </div>
    </div>
  </main>
  <section
    class="flex flex-col items-center gap-8 bg-neutral-100 p-16 text-center"
  >
    <h2 class="text-4xl">What We Offer</h2>
    <p class="mb-12 max-w-prose font-light text-neutral-600">
      Discover the various ways GOALS enriches your academic and personal
      journey through literature, oratory, and intellectual engagement.
    </p>
    <div
      class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-2 xl:grid-cols-4"
    >
      {
        aboutContent.map(({ icon, iconStyles, heading, description }) => (
          <SmallCard {icon} {iconStyles}>
            <Fragment slot="title">{heading}</Fragment>
            {description}
          </SmallCard>
        ))
      }
    </div>
  </section>
</Layout>
