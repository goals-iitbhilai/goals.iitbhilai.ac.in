---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/home/Hero.astro";
import WhatWeOffer from "@components/home/WhatWeOffer.astro";
import RecentActivities from "@components/home/RecentActivities.astro";
import Alumni from "@components/home/Alumni.astro";
import backgroundImg from "@assets/background.jpg";
import { getImage } from "astro:assets";

const backgroundSrc = (await getImage({ src: backgroundImg })).src;
---

<Layout>
  <Fragment name="head">
    <title>GOALS Home</title>
    <meta
      name="description"
      content="General Oratory and Literary Society, IIT Bhilai"
    />
  </Fragment>

  <Hero {backgroundSrc} />
  <WhatWeOffer />
  <RecentActivities />
  <Alumni {backgroundSrc} />
</Layout>
