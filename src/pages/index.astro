---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/routes/home/Hero.astro";
import WhatWeOffer from "@components/routes/home/WhatWeOffer.astro";
import RecentActivities from "@components/routes/home/RecentActivities.astro";
import Alumni from "@components/routes/home/Alumni.astro";
import backgroundImg from "@assets/background.jpg";
import { getImage } from "astro:assets";

const backgroundSrc = (await getImage({ src: backgroundImg })).src;
---

<Layout>
  <Hero {backgroundSrc} />
  <WhatWeOffer />
  <RecentActivities />
  <Alumni {backgroundSrc} />
</Layout>
