---
import Layout from "@layouts/Layout.astro";
import Link from "@components/Link.astro";
import Button from "@components/Button.astro";
import { Icon } from "astro-icon/components";
import backgroundImg from "@assets/background.jpg";
import { getImage, Image } from "astro:assets";
import Carousel from "@components/Carousel.astro";
import { getCollection } from "astro:content";

const background = await getImage({ src: backgroundImg });
const alumni = await getCollection("alumni");

const activities = [
  {
    title: "Annual Poetry Symposium",
    description:
      "Featured readings from renowned contemporary poets and student submissions.",
  },
  {
    title: "Inter-Collegiate Debate Championship",
    description: "Our team secured second place in the regional competition.",
  },
  {
    title: "Guest Lecture Series",
    description:
      "Monthly lectures by distinguished authors and literary scholars.",
  },
];

const quote = {
  text: "GOALS has transformed our understanding of literature and given us the confidence to express our ideas with clarity and conviction. The supportive community here encourages intellectual growth and creative expression.",
  cite: "Utkarsh and Kanishka",
  post: "Secretaries, GOALS",
};

const perks = [
  {
    icon: "lucide:mic",
    iconStyles: "bg-blue-100 text-blue-500 dark:bg-blue-700 dark:text-blue-100",
    heading: "Public Speaking",
    description:
      "Develop confidence and eloquence through anchoring in college " +
      "events or performing stand-up in events like Kavita, Meraz, Ciao, and Cultscape.",
  },
  {
    icon: "lucide:library",
    iconStyles:
      "bg-yellow-100 text-yellow-500 dark:bg-yellow-600 dark:text-yellow-100",
    heading: "Literary Analysis",
    description:
      "Dive into literary works through guided discussions and get " +
      "access to GOALS' exclusive library with a curated collection.",
  },
  {
    icon: "lucide:users",
    iconStyles:
      "bg-green-100 text-green-500 dark:bg-green-600 dark:text-green-100",
    heading: "Community",
    description:
      "Connect with like-minded individuals who share your passion for words and ideas.",
  },
  {
    icon: "lucide:award",
    iconStyles: "bg-red-100 text-red-500 dark:bg-red-800 dark:text-red-100",
    heading: "Competitions",
    description:
      "Participate in inter-collegiate debates, Inter IIT Cultural Meet, " +
      "Anubhuti, and writing competitions.",
  },
];
---

<Layout>
  <!-- Head -->
  <Fragment slot="head">
    <link rel="preload" as="image" href={background.src} fetchpriority="high" />
  </Fragment>

  <!-- Hero -->

  <main class="relative grid place-items-center py-16">
    <div
      class="absolute inset-0 -z-10 bg-cover bg-center"
      style={{ backgroundImage: `url(${background.src})` }}
    >
      <div class="dark:bg-primary-400/75 bg-secondary-700/80 -z-9 size-full">
      </div>
    </div>
    <div
      class="flex flex-col items-center gap-4 px-4 text-center text-balance text-neutral-50 dark:text-neutral-950"
    >
      <img src="/favicon.svg" alt="Logo" class="size-20" />
      <h1 class="text-7xl">General Oratory & <br />Literary Society</h1>
      <p class="font-serif text-5xl font-light">IIT Bhilai</p>
      <p class="mt-6 max-w-prose px-2 text-2xl font-extralight">
        Where eloquent voices meet literary minds. Join our community of
        speakers, writers, and critical thinkers shaping tomorrow's discourse.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-8">
        <Button kind="translucent" href="/members">Meet our Team</Button>
        <Button kind="translucent" href="/about" class="group">
          Learn More
          <div class="relative">
            <Icon name="lucide:chevron-right" class="absolute" />
            <Icon
              name="lucide:chevron-right"
              class="group-hover:translate-x-1.5"
              style="transition: all 0.15s ease"
            />
          </div>
        </Button>
      </div>
    </div>
  </main>

  <!-- Perks -->

  <section
    class="flex flex-col items-center gap-8 bg-neutral-100 p-8 text-center sm:p-12 xl:p-16 dark:bg-neutral-900"
  >
    <h2 class="text-4xl dark:text-neutral-50">What We Offer</h2>
    <p
      class="mb-12 max-w-prose font-light text-neutral-600 dark:text-neutral-300"
    >
      Discover the various ways GOALS enriches your academic and personal
      journey through literature, oratory, and intellectual engagement.
    </p>
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 xl:grid-cols-4">
      {
        perks.map(({ icon, iconStyles, heading, description }) => (
          <div class="flex flex-col items-center gap-6 rounded-lg bg-neutral-50 p-8 shadow-sm/10 dark:bg-neutral-800">
            <span>
              <Icon
                class:list={["size-10 rounded-full p-2", iconStyles]}
                name={icon}
              />
            </span>
            <h3 class="text-2xl font-light dark:text-neutral-100">{heading}</h3>
            <p class="font-light text-neutral-600 dark:text-neutral-400">
              {description}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <div class="relative grid grid-cols-1 pt-18 lg:grid-cols-2 lg:gap-8">
    <div class="absolute inset-0 -top-16 -z-1 overflow-hidden">
      <svg
        viewBox="0 0 900 450"
        class="h-2/5 w-full min-w-5xl"
        preserveAspectRatio="none"
        fill="currentColor"
        ><path
          d="M0 168L10.7 170.2C21.3 172.3 42.7 176.7 64.2 187.2C85.7 197.7 107.3 214.3 128.8 206.8C150.3 199.3 171.7 167.7 193 160.2C214.3 152.7 235.7 169.3 257 182.8C278.3 196.3 299.7 206.7 321.2 201.3C342.7 196 364.3 175 385.8 172C407.3 169 428.7 184 450 195.3C471.3 206.7 492.7 214.3 514.2 203.8C535.7 193.3 557.3 164.7 578.8 150.3C600.3 136 621.7 136 643 140.5C664.3 145 685.7 154 707 160.8C728.3 167.7 749.7 172.3 771.2 179.8C792.7 187.3 814.3 197.7 835.8 194.7C857.3 191.7 878.7 175.3 889.3 167.2L900 159L900 0L889.3 0C878.7 0 857.3 0 835.8 0C814.3 0 792.7 0 771.2 0C749.7 0 728.3 0 707 0C685.7 0 664.3 0 643 0C621.7 0 600.3 0 578.8 0C557.3 0 535.7 0 514.2 0C492.7 0 471.3 0 450 0C428.7 0 407.3 0 385.8 0C364.3 0 342.7 0 321.2 0C299.7 0 278.3 0 257 0C235.7 0 214.3 0 193 0C171.7 0 150.3 0 128.8 0C107.3 0 85.7 0 64.2 0C42.7 0 21.3 0 10.7 0L0 0Z"
          class="text-neutral-100 dark:text-neutral-900"></path><path
          d="M0 294L10.7 298.5C21.3 303 42.7 312 64.2 315C85.7 318 107.3 315 128.8 301.5C150.3 288 171.7 264 193 262.5C214.3 261 235.7 282 257 291.7C278.3 301.3 299.7 299.7 321.2 287.7C342.7 275.7 364.3 253.3 385.8 254.2C407.3 255 428.7 279 450 294.7C471.3 310.3 492.7 317.7 514.2 310.8C535.7 304 557.3 283 578.8 272.5C600.3 262 621.7 262 643 264.3C664.3 266.7 685.7 271.3 707 269.8C728.3 268.3 749.7 260.7 771.2 271.2C792.7 281.7 814.3 310.3 835.8 309.7C857.3 309 878.7 279 889.3 264L900 249L900 157L889.3 165.2C878.7 173.3 857.3 189.7 835.8 192.7C814.3 195.7 792.7 185.3 771.2 177.8C749.7 170.3 728.3 165.7 707 158.8C685.7 152 664.3 143 643 138.5C621.7 134 600.3 134 578.8 148.3C557.3 162.7 535.7 191.3 514.2 201.8C492.7 212.3 471.3 204.7 450 193.3C428.7 182 407.3 167 385.8 170C364.3 173 342.7 194 321.2 199.3C299.7 204.7 278.3 194.3 257 180.8C235.7 167.3 214.3 150.7 193 158.2C171.7 165.7 150.3 197.3 128.8 204.8C107.3 212.3 85.7 195.7 64.2 185.2C42.7 174.7 21.3 170.3 10.7 168.2L0 166Z"
          class="text-neutral-100/50 dark:text-neutral-800"></path></svg
      >
    </div>

    <!-- Activities -->
    <section class="flex flex-col items-start gap-8 p-16">
      <h2 class="text-3xl dark:text-neutral-50">Recent Activities</h2>
      <ul
        class="marker:text-secondary-600 dark:marker:text-primary-400 list-disc pl-4 font-light"
      >
        {
          activities.map((item) => (
            <li class="mb-4">
              <h3 class="text-xl text-neutral-800 dark:text-neutral-200">
                {item.title}
              </h3>
              <p class="max-w-prose text-sm text-neutral-600 dark:text-neutral-400">
                {item.description}
              </p>
            </li>
          ))
        }
      </ul>
      <Link href="/newsletters" class="flex items-center gap-1">
        Read our newsletters
        <Icon name="lucide:chevron-right" />
      </Link>
    </section>

    <!-- Quote -->

    <div class="flex items-center justify-center p-16 pt-8 lg:pt-16">
      <div class="relative h-fit w-fit">
        <div
          class="bg-secondary-700 dark:bg-primary-300 absolute inset-0 z-0 rotate-4 transform rounded-2xl"
        >
        </div>
        <blockquote
          class="relative rounded-2xl bg-white p-8 font-light shadow-sm dark:bg-neutral-700"
        >
          <p class="max-w-prose font-serif text-xl italic">
            &ldquo;{quote.text}&rdquo;
          </p>
          <cite>
            <br />
            <span>{quote.cite}</span>
            <br />
            <span class="text-sm text-neutral-600 dark:text-neutral-400">
              {quote.post}
            </span>
          </cite>
        </blockquote>
      </div>
    </div>
  </div>

  <!-- Alumni -->
  <section class="-mb-16 flex flex-col items-center gap-8 p-8 md:p-16">
    <div class="contents text-center">
      <h2
        id="voices-from-our-alumni"
        class="text-4xl font-medium dark:text-neutral-50"
      >
        Voices from our Alumni
      </h2>
      <p
        class="mb-4 max-w-prose text-lg text-neutral-600 dark:text-neutral-300"
      >
        Hear from our seniors who have found their voice through GOALS.
      </p>
    </div>

    <Carousel class="w-full max-w-4xl" aria-labelledby="voices-from-our-alumni">
      {
        alumni.map(({ data: { image, name, batch, message } }) => (
          <article class="flex h-full flex-col items-center gap-12 rounded-2xl bg-neutral-100 p-8 shadow-sm md:flex-row dark:bg-neutral-800">
            <Image
              src={image}
              alt={name}
              class="size-36 shrink-0 rounded-full border-4 border-neutral-200 object-cover md:size-42 dark:border-neutral-500"
            />
            <div class="text-center md:text-left">
              <p class="font-serif text-xl font-light italic">
                &ldquo;{message}&rdquo;
              </p>
              <div class="mt-6 border-t border-neutral-300 pt-4 dark:border-neutral-600">
                <p class="text-lg font-medium text-neutral-900 dark:text-neutral-100">
                  {name}
                </p>
                <p class="text-secondary-700 dark:text-secondary-400 text-sm">
                  {batch}
                </p>
              </div>
            </div>
          </article>
        ))
      }
    </Carousel>
  </section>
</Layout>
