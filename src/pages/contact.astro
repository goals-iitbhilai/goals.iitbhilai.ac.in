---
import PageLayout from "@layouts/PageLayout.astro";
import Button from "@components/Button.astro";
import Card from "@components/Card.astro";
import PrimaryIcon from "@components/PrimaryIcon.astro";
import { getCollection } from "astro:content";

const socials = await getCollection("socials");

const details = [
  {
    icon: "lucide:mail",
    heading: "Email",
    text: [
      "goals@iitbhilai.ac.in",
      "For general inquiries and membership questions",
    ],
  },
  {
    icon: "lucide:map-pin",
    heading: "Location",
    text: ["Academic Area", "IIT Bhilai, Kutelabhata, College Campus"],
  },
  {
    icon: "lucide:clock",
    heading: "Timings",
    text: ["5:30 PM onwards"],
  },
];

const faqs = [
  {
    question: "How can I become a member?",
    answer:
      "Simply attend one of our Friday meetings to learn more about GOALS and complete a brief membership form.",
  },
  {
    question: "Are there membership fees?",
    answer:
      "GOALS membership is free for all students. We believe in making literary and oratory opportunities accessible to everyone.",
  },
  {
    question: "What if I'm new to public speaking?",
    answer:
      "Perfect! GOALS welcomes members of all experience levels. We provide supportive workshops and mentoring for beginners.",
  },
];

const subjects = {
  membership: "Membership Inquiry",
  event: "Event Information",
  collaboration: "Collaboration Proposal",
  feedback: "Feedback",
  other: "Other",
};
---

<PageLayout>
  <div
    class="mx-auto grid w-full grid-cols-1 gap-8 px-8 sm:w-150 md:w-full md:grid-cols-2 lg:grid-rows-7 xl:w-4/5"
  >
    <!-- Infocard -->

    <Card
      as="section"
      class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-6 p-8 md:row-span-3"
    >
      <img class="size-16" src="/favicon.svg" alt="GOALS" />
      <div>
        <h2 class="text-2xl text-black dark:text-white">
          General Oratory & Literary Society
        </h2>
        <p>Building bridges through words</p>
      </div>
      {
        details.map(({ icon, heading, text }) => (
          <>
            <PrimaryIcon
              name={icon}
              kind="subtle"
              class="size-10 place-self-center"
            />
            <div>
              <h3 class="text-xl text-black dark:text-white">{heading}</h3>
              <div class="font-light">
                {text.map((text) => (
                  <p>{text}</p>
                ))}
              </div>
            </div>
          </>
        ))
      }
    </Card>

    <!-- Form -->

    <Card
      as="form"
      id="contact-form"
      class="flex flex-col gap-4 p-8 md:row-span-5"
    >
      <h2 class="text-2xl text-black dark:text-white">Send us a Message</h2>
      <label>
        Name
        <input placeholder="Your Name" type="text" required name="name" />
      </label>
      <label>
        Email
        <input
          placeholder="you@example.com"
          type="email"
          name="email"
          required
        />
      </label>
      <label>
        Subject
        <select required name="subject" class="cursor-pointer">
          <option value="">Select a subject</option>
          {
            Object.entries(subjects).map(([value, text]) => (
              <option {value}>{text}</option>
            ))
          }
        </select>
      </label>
      <label class="flex-1 pb-8">
        Message
        <textarea
          required
          name="message"
          placeholder="Your message"
          class="h-full"></textarea>
      </label>
      <Button type="submit">Send</Button>
    </Card>

    <!-- FAQ -->

    <Card as="section" class="p-8 md:row-span-3">
      <h2 class="mb-6 text-center text-2xl text-black dark:text-white">
        Frequently Asked Questions
      </h2>
      <ul class="flex flex-col gap-4">
        {
          faqs.map(({ question, answer }) => (
            <li>
              <h3 class="mb-1 text-xl leading-tight font-medium text-black dark:text-white">
                {question}
              </h3>
              <p class="font-light">{answer}</p>
            </li>
          ))
        }
      </ul>
    </Card>

    <!-- Socials -->

    <div class="md:row-span-2">
      <Card
        as="section"
        class="mb-auto flex flex-col items-center gap-6 p-8 md:items-start"
      >
        <h2 class="text-2xl text-black dark:text-white">Follow Us</h2>
        <div class="flex gap-6">
          {
            socials.map(({ id, data: { href, icon, theme } }) => (
              <a {href} aria-label={id}>
                <PrimaryIcon
                  name={icon}
                  kind="subtle"
                  style={`--theme-color: ${theme};`}
                  class="size-10 hover:bg-(--theme-color) hover:text-white"
                />
              </a>
            ))
          }
        </div>
        <p class="text-center font-light md:text-left">
          Stay updated with our latest events, announcements, and literary
          discussions.
        </p>
      </Card>
    </div>
  </div>
</PageLayout>

<style>
  @reference "../global.css";

  input[type="text"],
  input[type="email"],
  select,
  textarea {
    @apply mt-2 w-full rounded-lg border border-neutral-400 bg-neutral-50/25 p-3 hover:bg-neutral-100/25 dark:border-neutral-600 dark:bg-neutral-900 dark:hover:bg-neutral-800;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const endpointURL = "https://backend-five-delta-42.vercel.app/api/contact";
    const form = document.getElementById("contact-form") as HTMLFormElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      const response = await fetch(endpointURL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        alert("Message sent successfully!");
        form.reset();
      } else {
        alert("Failed to send message. Please try again later.");
      }
    });
  });
</script>
