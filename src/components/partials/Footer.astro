---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const links = await getCollection("links");
const socials = await getCollection("socials");
---

<footer
  class="bg-secondary-700 mt-16 px-6 py-8 text-[0.95rem] text-neutral-100"
>
  <div class="xs:grid-cols-2 grid grid-cols-1 gap-4 md:grid-cols-4">
    <section class="xs:col-span-2 col-span-1 p-4 md:col-span-2">
      <div class="flex items-center gap-4">
        <img src="/favicon.svg" alt="Logo" class="size-15" />
        <a href="/" class="group">
          <h5 class="text-2xl font-medium">GOALS</h5>
          <p class="text-secondary-200 group-hover:text-secondary-50">
            General Oratory & Literary Society, IIT Bhilai
          </p>
        </a>
      </div>
      <p class="xs:text-left mt-4 max-w-prose text-center">
        Fostering eloquence, literary excellence, and intellectual discourse in
        our academic community since our establishment.
      </p>
    </section>
    <section class="xs:col-span-1 xs:text-left col-span-1 p-4 text-center">
      <h5 class="mb-2 text-2xl">Society</h5>
      <ul
        class="text-secondary-200 xs:mx-0 mx-auto grid w-fit grid-cols-2 gap-x-8 gap-y-1"
      >
        {
          links
            .flatMap((v) =>
              v.data.kind == "link" ? v.data : [...v.data.items],
            )
            .map(({ name, href }) => (
              <li class="hover:text-secondary-50">
                <a {href}>{name}</a>
              </li>
            ))
        }
      </ul>
    </section>
    <section
      class="xs:text-left xs:mx-0 col-span-1 mx-auto p-4 text-center md:col-span-1"
    >
      <h5 class="mb-2 text-2xl">Connect with Us</h5>
      <a
        href="mailto:goals@iitbhilai.ac.in"
        class="text-secondary-200 hover:text-secondary-50 flex items-center gap-2"
      >
        <Icon name="lucide:mail" class="size-5" />
        <p>goals@iitbhilai.ac.in</p>
      </a>
      <div class="xs:justify-start mt-3 -ml-1 flex justify-center gap-4">
        {
          socials.map(({ id, data: { icon, href } }) => (
            <a
              {href}
              aria-label={`Visit GOALS on ${id}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-secondary-200 hover:text-secondary-50"
            >
              <Icon name={icon} class="size-8" />
            </a>
          ))
        }
      </div>
    </section>
  </div>
  <div
    class="border-secondary-400 mt-6 flex flex-col items-center justify-between border-t px-4 pt-5 text-center md:flex-row md:text-start"
  >
    <p>
      &copy; {new Date().getFullYear()} General Oratory & Literary Society. All rights
      reserved.
    </p>
    <p>
      Inspiring minds through words and wisdom ·&nbsp;
      <a
        href="https://github.com/goals-iitbhilai/goals.iitbhilai.ac.in"
        class="text-secondary-200 hover:text-secondary-50 inline-flex items-center"
      >
        Github
        <Icon name="lucide:arrow-up-right" class="size-5" />
      </a>
    </p>
  </div>
</footer>
