---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import Link from "@components/Link.astro";

const links = await getCollection("links");
---

<header id="header" class="group sticky top-0 z-50 touch-none font-light">
  <div
    class="absolute w-full border-b border-b-neutral-300 bg-neutral-50/50 backdrop-blur-md data-open:border-b-0 md:flex dark:border-b-neutral-700 dark:bg-neutral-950/75"
  >
    <div class="flex flex-1 items-center justify-between px-6 py-3">
      <div class="flex items-center gap-4">
        <img src="/favicon.svg" alt="Logo" class="size-9" />
        <a href="/" class="-mt-1">
          <h5
            class="text-secondary-800 dark:text-primary-500 text-2xl font-medium"
          >
            GOALS
          </h5>
          <p class="dark:text-secondary-300 -mt-1 text-xs">
            General Oratory And Literary Society
          </p>
        </a>
      </div>
      <button
        id="header-btn"
        class="inline-flex size-8 cursor-pointer items-center justify-center rounded-md hover:bg-white/20 md:hidden"
        aria-label="Toggle collapsible mennu"
      >
        <svg
          class="pointer-events-none size-5 fill-current"
          viewBox="0 0 16 16"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect
            class="origin-center -translate-y-1.25 group-data-open:translate-x-0 group-data-open:translate-y-0 group-data-open:rotate-45"
            y="7"
            width="16"
            height="2"
            rx="1"></rect>
          <rect
            class="origin-center group-data-open:rotate-45"
            y="7"
            width="16"
            height="2"
            rx="1"></rect>
          <rect
            class="origin-center translate-y-1.25 group-data-open:translate-y-0 group-data-open:-rotate-45"
            y="7"
            width="16"
            height="2"
            rx="1"></rect>
        </svg>
      </button>
    </div>
    <div
      class="grid grid-rows-[0fr] group-data-open:grid-rows-[1fr] md:flex md:items-center md:pr-6"
      style="transition: all 0.3s cubic-bezier(0.215, 0.610, 0.355, 1)"
    >
      <div
        class="flex min-h-0 flex-col items-center gap-12 overflow-hidden md:flex-row md:gap-4"
      >
        <nav class="mt-16 flex flex-col gap-8 py-2 md:mt-0 md:flex-row md:py-1">
          {links.map(({ data: { name, href } }) => <Link {href}>{name}</Link>)}
        </nav>

        <button
          id="theme-switch"
          class="mb-6 flex cursor-pointer items-center gap-4 rounded-sm px-4 py-3 hover:bg-neutral-200/80 hover:text-neutral-700 md:mb-0 md:p-2 dark:hover:bg-neutral-800 dark:hover:text-neutral-300"
        >
          <div class="md:hidden">
            <p class="hidden dark:block">Dark Theme</p>
            <p class="dark:hidden">Light Theme</p>
          </div>
          <Icon name="lucide:sun" class="size-5 dark:hidden" />
          <Icon name="lucide:moon" class="hidden size-5 dark:block" />
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("header")!;
  const headerBtn = document.getElementById("header-btn")!;
  const html = document.documentElement;

  document.getElementById("theme-switch")!.addEventListener("click", () => {
    html.classList.toggle("dark");
    localStorage.setItem(
      "theme",
      html.classList.contains("dark") ? "dark" : "light",
    );
  });

  function closeHeader() {
    header.removeAttribute("data-open");
    window.removeEventListener("click", headerOnClick);
    window.removeEventListener("scroll", closeHeader);
  }

  function headerOnClick(ev: MouseEvent) {
    if (!header.contains(ev.target as Node)) closeHeader();
  }

  headerBtn.addEventListener("click", () => {
    if (header.hasAttribute("data-open")) {
      closeHeader();
    } else {
      header.setAttribute("data-open", "");
      window.addEventListener("click", headerOnClick);
      window.addEventListener("scroll", closeHeader);
    }
  });
</script>
