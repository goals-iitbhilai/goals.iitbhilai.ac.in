---
import { Icon } from "astro-icon/components";

const content = [
  {
    title: "Annual Poetry Symposium",
    description:
      "Featured readings from renowned contemporary poets and student submissions.",
  },
  {
    title: "Inter-Collegiate Debate Championship",
    description: "Our team secured second place in the regional competition.",
  },
  {
    title: "Guest Lecture Series",
    description:
      "Monthly lectures by distinguished authors and literary scholars.",
  },
];
---

<section
  class="grid grid-cols-1 bg-neutral-100/50 lg:grid-cols-2 lg:gap-8 dark:bg-neutral-800"
>
  <section class="flex flex-col items-start gap-8 p-16">
    <h2 class="text-3xl dark:text-neutral-50">Recent Activities</h2>
    <ul
      class="marker:text-secondary-800 dark:marker:text-primary-400 list-disc pl-4 font-light"
    >
      {
        content.map((item) => (
          <li class="mb-4">
            <h3 class="text-xl text-neutral-800 dark:text-neutral-200">
              {item.title}
            </h3>
            <p class="max-w-prose text-sm text-neutral-600 dark:text-neutral-400">
              {item.description}
            </p>
          </li>
        ))
      }
    </ul>
    <a
      href="/editorials"
      class="relative flex w-fit items-center gap-1 after:absolute after:bottom-0 after:block after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-neutral-950 after:transition after:content-[''] hover:after:scale-x-83 dark:after:bg-neutral-50"
    >
      Read our Editorials
      <Icon name="lucide:chevron-right" />
    </a>
  </section>
  <section class="flex items-center justify-center p-16 pt-8 lg:pt-16">
    <div class="relative h-fit w-fit">
      <div
        class="bg-secondary-700 dark:bg-primary-300 absolute inset-0 z-0 rotate-4 transform rounded-2xl"
      >
      </div>
      <blockquote
        class="relative z-20 rounded-2xl bg-white p-8 font-light shadow-sm dark:bg-neutral-700"
      >
        <p class="max-w-prose font-serif text-xl italic dark:text-neutral-200">
          &ldquo; GOALS has transformed our understanding of literature and
          given us the confidence to express our ideas with clarity and
          conviction. The supportive community here encourages intellectual
          growth and creative expression. &rdquo;
        </p>
        <cite>
          <br />
          <span>Utkarsh and Kanishka</span>
          <br />
          <span class="text-sm text-neutral-600 dark:text-neutral-400">
            Secretaries, GOALS
          </span>
        </cite>
      </blockquote>
    </div>
  </section>
</section>
