---
const content = [
  {
    title: "Annual Poetry Symposium",
    description:
      "Featured readings from renowned contemporary poets and student submissions.",
  },
  {
    title: "Inter-Collegiate Debate Championship",
    description: "Our team secured second place in the regional competition.",
  },
  {
    title: "Guest Lecture Series",
    description:
      "Monthly lectures by distinguished authors and literary scholars.",
  },
];
---

<section class="grid grid-cols-1 gap-8 bg-neutral-100/50 lg:grid-cols-2">
  <section class="flex flex-col items-start gap-8 p-16">
    <h2 class="text-3xl">Recent Activities</h2>
    <ul class="list-disc pl-4">
      {
        content.map((item) => (
          <li class="mb-4">
            <h3 class="text-xl font-light text-neutral-800">{item.title}</h3>
            <p class="max-w-prose text-sm font-light text-neutral-600">
              {item.description}
            </p>
          </li>
        ))
      }
    </ul>
  </section>
  <section class="flex items-center justify-center p-16">
    <div class="relative h-fit w-fit">
      <div
        class="bg-secondary-700 absolute inset-0 -z-10 rotate-4 transform rounded-2xl"
      >
      </div>
      <blockquote class="rounded-2xl bg-white p-8 shadow-sm">
        <p class="max-w-prose font-serif text-xl font-light italic">
          &ldquo; GOALS has transformed our understanding of literature and
          given us the confidence to express our ideas with clarity and
          conviction. The supportive community here encourages intellectual
          growth and creative expression. &rdquo;
        </p>
        <cite>
          <br />
          <span>Utkarsh and Kanishka</span>
          <br />
          <span class="text-sm font-light text-neutral-600">
            Secretaries, GOALS
          </span>
        </cite>
      </blockquote>
    </div>
  </section>
</section>
