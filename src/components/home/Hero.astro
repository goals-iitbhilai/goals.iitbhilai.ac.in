---
import LinkButton from "@components/ui/LinkButton.astro";
import { getURL } from "@utils/url";
import { Icon } from "astro-icon/components";

interface Props {
  backgroundSrc: string;
}

const { backgroundSrc } = Astro.props;
---

<main class="relative flex h-full w-full items-center justify-center py-16">
  <div
    class="absolute inset-0 -z-10 bg-cover bg-center"
    style={{ backgroundImage: `url(${backgroundSrc})` }}
  >
    <div
      class="dark:bg-primary-400/80 bg-secondary-700/80 absolute inset-0 z-[-9]"
    >
    </div>
  </div>
  <div
    class="flex flex-col items-center gap-4 px-4 text-center text-neutral-50 md:static md:pt-0 dark:text-neutral-950"
  >
    <img src={getURL("/favicon.svg")} alt="Logo" class="size-20" />
    <h1 class="text-7xl">General Oratory & <br />Literary Society</h1>
    <h2 class="text-5xl font-light">IIT Bhilai</h2>
    <p class="mt-6 max-w-prose px-2 text-2xl font-extralight">
      Where eloquent voices meet literary minds. Join our community of speakers,
      writers, and critical thinkers shaping tomorrow's discourse.
    </p>
    <div class="xs:flex-row mt-6 flex flex-col gap-8">
      <LinkButton href={getURL("/members")}>Meet our Team</LinkButton>
      <LinkButton href={getURL("/about")} class="flex items-center gap-2">
        Learn More
        <Icon name="lucide:chevron-right" />
      </LinkButton>
    </div>
  </div>
</main>
