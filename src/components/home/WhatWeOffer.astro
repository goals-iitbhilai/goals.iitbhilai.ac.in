---
import SmallCard from "@components/SmallCard.astro";

const content = [
  {
    icon: "lucide:mic",
    iconStyles: "bg-blue-100 text-blue-500 dark:bg-blue-700 dark:text-blue-100",
    heading: "Public Speaking",
    description:
      "Develop confidence and eloquence through anchoring in college " +
      "events or performing stand-up in events like Kavita, Meraz, Ciao, and Cultscape.",
  },
  {
    icon: "lucide:library",
    iconStyles:
      "bg-yellow-100 text-yellow-500 dark:bg-yellow-600 dark:text-yellow-100",
    heading: "Literary Analysis",
    description:
      "Dive into literary works through guided discussions and get " +
      "access to GOALS' exclusive library with a curated collection.",
  },
  {
    icon: "lucide:users",
    iconStyles:
      "bg-green-100 text-green-500 dark:bg-green-600 dark:text-green-100",
    heading: "Community",
    description:
      "Connect with like-minded individuals who share your passion for words and ideas.",
  },
  {
    icon: "lucide:award",
    iconStyles: "bg-red-100 text-red-500 dark:bg-red-800 dark:text-red-100",
    heading: "Competitions",
    description:
      "Participate in inter-collegiate debates, Inter IIT Cultural Meet, " +
      "Anubhuti, and writing competitions.",
  },
];
---

<section
  class="flex flex-col items-center gap-8 bg-neutral-100 p-16 text-center dark:bg-neutral-900"
>
  <h2 class="text-4xl dark:text-neutral-50">What We Offer</h2>
  <p
    class="mb-12 max-w-prose font-light text-neutral-600 dark:text-neutral-300"
  >
    Discover the various ways GOALS enriches your academic and personal journey
    through literature, oratory, and intellectual engagement.
  </p>
  <div
    class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-2 xl:grid-cols-4"
  >
    {
      content.map(({ icon, iconStyles, heading, description }) => (
        <SmallCard {icon} {iconStyles}>
          <Fragment slot="title">{heading}</Fragment>
          {description}
        </SmallCard>
      ))
    }
  </div>
</section>
