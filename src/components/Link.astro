---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { class: className, ...rest } = Astro.props;
---

<a
  class:list={[
    "relative w-fit after:absolute after:bottom-0 after:block after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-neutral-950 after:content-[''] hover:after:scale-x-100 dark:after:bg-neutral-50",
    className,
  ]}
  {...rest}
>
  <slot />
</a>
