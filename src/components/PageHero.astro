---
interface Props {
  heading: string;
}

const { heading } = Astro.props;
---

<section class="px-8 py-16">
  <div class="mx-auto flex flex-col items-center gap-8 md:w-216">
    <h1 class="text-center text-6xl font-bold dark:text-white">
      {heading}
    </h1>
    <p class="max-w-prose text-center text-xl font-light">
      <slot />
    </p>
  </div>
</section>
