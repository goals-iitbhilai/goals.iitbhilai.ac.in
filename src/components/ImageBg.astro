---
import type { HTMLTag, Polymorphic } from "astro/types";
import backgroundImg from "@assets/background.jpg";
import { getImage } from "astro:assets";

type Props<Tag extends HTMLTag = "div"> = {
  overlay?: "primary" | "neutral";
} & Polymorphic<{ as: Tag }>;

const {
  as: Tag = "div",
  overlay = "primary",
  class: className,
  ...rest
} = Astro.props;

const background = await getImage({ src: backgroundImg });
---

<Tag class:list={["relative", className]} {...rest}>
  <div
    class="absolute inset-0 -z-10 bg-cover bg-center"
    style={{ backgroundImage: `url(${background.src})` }}
  >
    <div
      class:list={[
        "-z-9 size-full",
        {
          primary: "dark:bg-primary-400/75 bg-secondary-700/80",
          neutral: "bg-neutral-100/80 dark:bg-neutral-800/80",
        }[overlay],
      ]}
    >
    </div>
  </div>
  <slot />
</Tag>
