---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a
  {href}
  class={`px-5 py-3 rounded-md backdrop-blur-2xl bg-linear-300 bg-size-[200%] bg-bottom-right duration-500 hover:bg-bottom-left transition-all from-white/20 via-white/30 to-white/20  border border-neutral-200/20  ${className}`}
>
  <slot />
</a>
