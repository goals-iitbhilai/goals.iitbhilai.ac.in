---
import Card from "@components/Card.astro";
import PrimaryIcon from "@components/PrimaryIcon.astro";
import Button from "@components/Button.astro";
import { Icon } from "astro-icon/components";
---

<Card
  as="section"
  class="flex w-full flex-col items-center justify-between gap-12 p-8 md:flex-row md:gap-0"
>
  <div class="xs:flex-row flex flex-col items-center gap-8">
    <PrimaryIcon name="lucide:scroll-text" kind="subtle" class="size-15 p-4" />
    <div>
      <h2 class="xs:mb-1 mb-4 text-center text-3xl">Official Constitution</h2>
      <div class="text-sm font-light text-neutral-500 dark:text-neutral-400">
        <span class="flex items-center gap-1">
          <Icon name="lucide:calendar" />
          <p>Last Updated: February 2023</p>
        </span>
        <span class="flex items-center gap-1">
          <Icon name="lucide:file-text" />
          <p>Version 3.2</p>
        </span>
      </div>
    </div>
  </div>
  <Button
    href="https://docs.google.com/document/d/1j4SqzgNCl2IK8xXdd5LH9dmaiBPQvEr2dSCRY_dQ_Cc/edit?tab=t.0"
  >
    <Icon name="lucide:link" />
    <p>View Document</p>
  </Button>
</Card>
