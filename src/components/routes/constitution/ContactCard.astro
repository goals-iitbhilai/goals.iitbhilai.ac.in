---
import Card from "@components/Card.astro";
import Button from "@components/Button.astro";
import { getURL } from "@utils/url";
---

<Card
  class="mx-auto my-16 flex max-w-prose flex-col items-center gap-6 p-8 text-center md:w-3/5"
>
  <h3 class="text-2xl text-black dark:text-white">
    Questions About Our Constitution?
  </h3>
  <p class="max-w-prose">
    If you have questions about our governing principles or would like to
    propose an amendment, please reach out to our officers or attend our next
    meeting.
  </p>
  <Button href={getURL("/contact")}>Contact Us</Button>
</Card>
