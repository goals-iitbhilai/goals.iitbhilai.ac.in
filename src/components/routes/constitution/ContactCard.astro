---
import { getURL } from "@utils/url";
---

<section class="flex flex-col items-center px-4 py-8">
  <div
    class="flex max-w-prose flex-col items-center gap-6 rounded-xl bg-white p-8 text-center shadow-sm md:w-3/5 dark:border dark:border-neutral-600 dark:bg-neutral-800"
  >
    <h3 class="text-2xl text-black dark:text-white">
      Questions About Our Constitution?
    </h3>
    <p class="max-w-prose">
      If you have questions about our governing principles or would like to
      propose an amendment, please reach out to our officers or attend our next
      meeting.
    </p>
    <a
      href={getURL("/contact")}
      class="bg-secondary-700 dark:bg-primary-400 dark:hover:bg-primary-300 dark:active:bg-primary-500 hover:bg-secondary-600 active:bg-secondary-500 rounded-md px-4 py-3 text-white shadow-sm transition-colors dark:text-black"
    >
      <p>Contact Us</p>
    </a>
  </div>
</section>
