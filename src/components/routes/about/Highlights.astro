---
import Card from "@components/Card.astro";
import { Icon } from "astro-icon/components";

const contents = [
  {
    title: "Our Mission",
    icon: "lucide:target",
    description:
      "To cultivate eloquence, critical thinking, and literary appreciation among students" +
      " through engaging discussions, workshops, and public speaking opportunities. We strive" +
      " to create an environment of avid writers.",
  },
  {
    title: "Our History",
    icon: "lucide:history",
    description:
      "Founded on March 28, 2019, GOALS has been a cornerstone of intellectual life on campus." +
      " Our society has nurtured countless writers, speakers, and thought leaders. Cultivated a" +
      " vibrant campus atmosphere be it cultural events, MERAZ (Annual Techno-Cultural fest" +
      " of IIT Bhilai) or Guest lectures.",
  },
];
---

<section class="px-8 pb-16">
  <div class="mx-auto flex flex-col items-center gap-8 md:w-216">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        contents.map(({ title, icon, description }) => (
          <Card outlined={true} class="p-8">
            <div class="mb-4 flex items-center gap-4">
              <Icon
                name={icon}
                class="text-secondary-700 dark:text-primary-500 size-6"
              />
              <h3 class="text-2xl text-black dark:text-white">{title}</h3>
            </div>
            <p class="max-w-prose">{description}</p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
