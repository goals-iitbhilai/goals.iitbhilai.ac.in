---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";

const content = await getCollection("team");

const secretaries = content.filter((entry) => entry.data.post == "Secretary");
const members = content.filter((entry) => entry.data.post != "Secretary");
---

<div class="flex flex-col gap-16">
  <h2 class="text-center text-5xl font-bold dark:text-white">Secretaries</h2>
  <div
    class="mx-auto grid grid-cols-1 justify-center gap-6 sm:grid-cols-2 md:w-3/4"
  >
    {
      secretaries.map(({ data: { image, name, quote } }) => (
        <div class="flex w-full flex-none snap-start flex-col items-center justify-between px-4">
          <Picture
            src={image}
            class="box-content size-56 rounded-full border-4 border-neutral-200 object-cover dark:border-neutral-400"
            alt={name}
          />
          <div class="flex h-full w-2/3 flex-col items-center gap-4 py-4 sm:w-3/4">
            <p class="mt-auto text-center font-serif text-xl font-light text-balance italic">
              &ldquo;{quote}&rdquo;
            </p>
            <div class="border-t border-t-neutral-400 pt-4 text-center dark:border-t-neutral-500">
              <p class="my-1 font-medium">{name}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<div class="mt-20 mb-16 flex flex-col gap-16">
  <h2 class="text-center text-5xl font-bold dark:text-white">Core Members</h2>
  <div
    class="mx-auto flex flex-wrap items-stretch justify-center gap-y-12 md:w-5/6"
  >
    {
      members.map(({ data: { image, name, quote, post } }) => (
        <div class="flex w-full snap-start flex-col items-center justify-between px-4 sm:w-1/2 lg:w-1/3">
          <Picture
            src={image}
            class="box-content size-48 rounded-full border-4 border-neutral-200 object-cover object-top dark:border-neutral-400"
            alt={name}
          />
          <div class="flex h-full w-2/3 flex-col items-center gap-4 py-4 sm:w-full">
            <p class="mt-auto text-center font-serif text-xl font-light text-balance italic">
              &ldquo;{quote}&rdquo;
            </p>
            <div class="border-t border-t-neutral-400 pt-4 text-center dark:border-t-neutral-500">
              <p class="my-1 font-medium">{name}</p>
              <p class="text-secondary-600 dark:text-secondary-400 text-sm">
                {post}
              </p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>
