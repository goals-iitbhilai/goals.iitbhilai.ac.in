---
import { Icon } from "astro-icon/components";

interface Props {
  icon: string;
  iconStyles: string;
}

const { icon, iconStyles } = Astro.props;
---

<div
  class="flex flex-col items-center gap-6 rounded-lg bg-neutral-50 p-8 shadow-sm/10 dark:bg-neutral-800"
>
  <span>
    <Icon class={`size-10 p-2 rounded-full ${iconStyles}`} name={icon} />
  </span>
  <h3 class="text-2xl font-light dark:text-neutral-100">
    <slot name="title" />
  </h3>
  <p class="font-light text-neutral-600 dark:text-neutral-400"><slot /></p>
</div>
