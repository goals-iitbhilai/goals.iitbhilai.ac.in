---
import { Icon } from "astro-icon/components";
---

<button
  id="switch"
  class:list={[
    "mb-6 flex cursor-pointer items-center gap-4 rounded-sm px-4 py-3 md:mb-0 md:p-2",
    "hover:bg-neutral-800 hover:text-neutral-100 dark:hover:bg-neutral-100 dark:hover:text-neutral-800",
    "md:hover:bg-neutral-200/80 md:hover:text-neutral-700 md:dark:hover:bg-neutral-800 md:dark:hover:text-neutral-300",
  ]}
>
  <div class="md:hidden">
    <p class="hidden dark:block">Dark Theme</p>
    <p class="dark:hidden">Light Theme</p>
  </div>
  <Icon name="lucide:sun" class="size-5 dark:hidden" />
  <Icon name="lucide:moon" class="hidden size-5 dark:block" />
</button>

<script>
  const html = document.documentElement;
  document.getElementById("switch")?.addEventListener("click", () => {
    html.classList.toggle("dark");
    localStorage.setItem(
      "theme",
      html.classList.contains("dark") ? "dark" : "light",
    );
  });
</script>
