---
import ThemeSwitch from "./ThemeSwitch.astro";
import { getURL, homeURL } from "@utils/url";
import { getCollection } from "astro:content";

const links = await getCollection("links");
---

<header id="header" class="group sticky top-0 z-50 touch-none font-light">
  <div
    class="absolute w-full border-b border-b-neutral-300 bg-neutral-50/50 backdrop-blur-md data-open:border-b-0 md:flex dark:border-b-neutral-700 dark:bg-neutral-950/75"
  >
    <div class="flex flex-1 items-center justify-between px-6 py-3">
      <div class="flex items-center gap-4">
        <img src={getURL("/favicon.svg")} alt="Logo" class="size-9" />
        <a href={homeURL} class="-mt-1">
          <h5
            class="text-secondary-800 dark:text-primary-500 text-2xl font-medium"
          >
            GOALS
          </h5>
          <p class="dark:text-secondary-300 -mt-1 text-xs">
            General Oratory And Literary Society
          </p>
        </a>
      </div>
      <button
        id="header-btn"
        class="inline-flex size-8 cursor-pointer items-center justify-center rounded-md hover:bg-white/20 md:hidden"
        aria-label="Toggle collapsible mennu"
      >
        <svg
          class="pointer-events-none size-5 fill-current"
          viewBox="0 0 16 16"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect
            class="origin-center -translate-y-1.25 group-data-open:translate-x-0 group-data-open:translate-y-0 group-data-open:rotate-45"
            y="7"
            width="16"
            height="2"
            rx="1"></rect>
          <rect
            class="origin-center group-data-open:rotate-45"
            y="7"
            width="16"
            height="2"
            rx="1"></rect>
          <rect
            class="origin-center translate-y-1.25 group-data-open:translate-y-0 group-data-open:-rotate-45"
            y="7"
            width="16"
            height="2"
            rx="1"></rect>
        </svg>
      </button>
    </div>
    <div
      class="grid grid-rows-[0fr] group-data-open:grid-rows-[1fr] md:flex md:items-center md:pr-6"
      style="transition: all 0.3s cubic-bezier(0.215, 0.610, 0.355, 1)"
    >
      <div
        class="flex min-h-0 flex-col items-center gap-12 overflow-hidden md:flex-row md:gap-4"
      >
        <nav class="mt-16 flex flex-col gap-2 md:mt-0 md:flex-row">
          {
            links.map(({ data: { name, href } }) => (
              <a
                href={getURL(href)}
                class="hover:bg-secondary-700 active:bg-secondary-800 hover:text-secondary-50 dark:hover:text-primary-950 dark:hover:bg-primary-500 dark:active:bg-primary-400 rounded-sm px-3 py-2 md:py-1"
              >
                {name}
              </a>
            ))
          }
        </nav>
        <ThemeSwitch />
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("header")!;
  const headerBtn = document.getElementById("header-btn")!;

  function handleOutsideClick(ev: MouseEvent) {
    if (!header.contains(ev.target as Node)) {
      header.removeAttribute("data-open");
      window.removeEventListener("scroll", handleScroll);
      window.removeEventListener("click", handleOutsideClick);
    }
  }

  function handleScroll() {
    header.removeAttribute("data-open");
    window.removeEventListener("scroll", handleScroll);
    window.removeEventListener("click", handleOutsideClick);
  }

  headerBtn.addEventListener("click", () => {
    if (header.hasAttribute("data-open")) {
      header.removeAttribute("data-open");
      window.removeEventListener("click", handleOutsideClick);
      window.removeEventListener("scroll", handleScroll);
    } else {
      header.setAttribute("data-open", "");
      window.addEventListener("click", handleOutsideClick);
      window.addEventListener("scroll", handleScroll);
    }
  });
</script>
