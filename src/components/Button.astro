---
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag = "button"> = {
  href?: string;
  kind?: "primary" | "translucent" | "ghost";
} & Polymorphic<{ as: Tag }>;

const { as, kind = "primary", class: className, ...rest } = Astro.props;
const Tag: HTMLTag = as || rest.href ? "a" : "button";
---

<Tag
  class:list={[
    "flex items-center justify-center gap-3 rounded-md px-5 py-3",
    { "cursor-pointer": Tag != "a" },
    {
      primary:
        "bg-secondary-700 dark:bg-primary-400 dark:hover:bg-primary-300 dark:active:bg-primary-500 hover:bg-secondary-600 active:bg-secondary-500 text-white shadow-sm dark:text-black",
      translucent:
        "border border-white/50 bg-white/25 backdrop-blur-2xl hover:border-white/75 hover:bg-white/35",
      ghost: "hover:bg-neutral-200/80 dark:hover:bg-neutral-800",
    }[kind],
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
