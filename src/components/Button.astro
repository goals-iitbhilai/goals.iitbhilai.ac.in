---
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag = "button"> = {
  href?: string;
} & Polymorphic<{ as: Tag }>;

const { as, class: className, ...rest } = Astro.props;
const Tag: HTMLTag = as || rest.href ? "a" : "button";
---

<Tag
  class:list={[
    "bg-secondary-700 dark:bg-primary-400 dark:hover:bg-primary-300 dark:active:bg-primary-500 hover:bg-secondary-600 active:bg-secondary-500 flex items-center justify-center gap-3 rounded-md px-4 py-3 text-white shadow-sm dark:text-black",
    {
      "cursor-pointer": Tag != "a",
    },
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
