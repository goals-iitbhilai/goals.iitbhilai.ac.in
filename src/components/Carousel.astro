---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";
import { parse } from "node-html-parser";

const id = crypto.randomUUID();
const html = await Astro.slots.render("default");
const children = parse(html).children;

type Props = HTMLAttributes<"div">;
const props = Astro.props;
---

<div data-carousel-root role="group" aria-roledescription="carousel" {...props}>
  <div class="relative">
    <!-- Track container -->
    <div
      data-carousel-container
      tabindex="0"
      class="touch-pan-y overflow-hidden"
    >
      <ul
        data-carousel-track
        class="flex"
        style="transition: transform 0.15s ease;"
      >
        {
          children.map((item, index) => (
            <li
              id={`carousel-slide-${index}-${id}`}
              class="w-full shrink-0 px-2 sm:px-8"
              role="group"
              aria-roledescription="slide"
            >
              <Fragment set:html={item.toString()} />
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Arrow buttons -->
    <button
      data-carousel-prev
      aria-label="Previous slide"
      class="absolute top-1/2 left-0 -translate-y-1/2 cursor-pointer rounded-full bg-neutral-50 p-2 shadow-sm ring-1 ring-neutral-200 hover:bg-neutral-100 disabled:pointer-events-none disabled:opacity-50 dark:bg-neutral-900 dark:ring-neutral-700 dark:hover:bg-neutral-800"
    >
      <Icon name="lucide:chevron-left" class="size-5" />
    </button>
    <button
      data-carousel-next
      aria-label="Next slide"
      class="absolute top-1/2 right-0 -translate-y-1/2 cursor-pointer rounded-full bg-neutral-50 p-2 shadow-sm ring-1 ring-neutral-200 hover:bg-neutral-100 disabled:pointer-events-none disabled:opacity-50 dark:bg-neutral-900 dark:ring-neutral-700 dark:hover:bg-neutral-800"
    >
      <Icon name="lucide:chevron-right" class="size-5" />
    </button>
  </div>

  <!-- Anchors -->
  <div class="mt-6 flex justify-center gap-2">
    {
      Array.from({ length: children.length }).map((_, index) => (
        <button
          data-carousel-dot
          aria-label={`Go to slide ${index + 1}`}
          aria-controls={`carousel-slide-${index}-${id}`}
          class="data-active:bg-secondary-700 data-active:dark:bg-secondary-400 size-2.5 cursor-pointer rounded-full bg-neutral-300 hover:bg-neutral-500 dark:bg-neutral-700"
        />
      ))
    }
  </div>
</div>

<script>
  class Carousel {
    currentIndex = 0;

    dots: HTMLButtonElement[];
    container: HTMLDivElement;
    track: HTMLUListElement;
    prev: HTMLButtonElement;
    next: HTMLButtonElement;

    constructor(root: Element) {
      this.container = root.querySelector("[data-carousel-container]")!;
      this.track = root.querySelector("[data-carousel-track]")!;
      this.prev = root.querySelector("button[data-carousel-prev]")!;
      this.next = root.querySelector("button[data-carousel-next]")!;

      this.prev.addEventListener("click", () => {
        this.update(this.currentIndex - 1);
      });

      this.next.addEventListener("click", () => {
        this.update(this.currentIndex + 1);
      });

      this.dots = this.registerDots(root);
      this.registerEvents();
      this.update(0);
    }

    registerDots(root: Element): HTMLButtonElement[] {
      const elements = root.querySelectorAll("[data-carousel-dot]");
      const dots = Array.from(elements) as HTMLButtonElement[];

      for (const [index, dot] of dots.entries()) {
        dot.addEventListener("click", () => {
          this.update(index);
        });
      }

      return dots;
    }

    registerEvents() {
      this.container.addEventListener("keydown", (ev) => {
        if (ev.key === "ArrowLeft") {
          this.update(this.currentIndex - 1);
        } else if (ev.key === "ArrowRight") {
          this.update(this.currentIndex + 1);
        }
      });

      let touchStartX = 0;
      let touchStartY = 0;
      let touchDeltaX = 0;
      let isDragging = false;
      let isSwiping = false;

      this.container.addEventListener(
        "touchstart",
        (ev) => {
          const touch = ev.changedTouches[0];
          touchStartX = touch.clientX;
          touchStartY = touch.clientY;
          touchDeltaX = 0;
          isDragging = true;
          isSwiping = false;
        },
        { passive: true },
      );

      this.container.addEventListener(
        "touchmove",
        (ev) => {
          if (!isDragging) return;

          const touch = ev.changedTouches[0];
          const deltaX = touch.clientX - touchStartX;
          const deltaY = touch.clientY - touchStartY;

          if (!isSwiping) {
            if (Math.abs(deltaX) < 6 && Math.abs(deltaY) < 6) return;

            if (Math.abs(deltaX) <= Math.abs(deltaY)) {
              isDragging = false;
              return;
            }

            isSwiping = true;
            this.track.style.transition = "none";
          }

          touchDeltaX = deltaX;
          this.setDragOffset(touchDeltaX);
          ev.preventDefault();
        },
        { passive: false },
      );

      this.container.addEventListener(
        "touchend",
        () => {
          if (!isDragging) return;
          isDragging = false;

          if (!isSwiping) return;

          isSwiping = false;
          this.track.style.transition = "transform 0.15s ease";

          const threshold = Math.min(80, this.container.clientWidth * 0.2);
          if (Math.abs(touchDeltaX) <= threshold) {
            this.update(this.currentIndex);
            return;
          }

          const direction = touchDeltaX > 0 ? -1 : 1;
          const target = Math.max(
            0,
            Math.min(
              this.track.children.length - 1,
              this.currentIndex + direction,
            ),
          );
          this.update(target);
        },
        { passive: true },
      );

      this.container.addEventListener(
        "touchcancel",
        () => {
          if (!isSwiping) return;

          isDragging = false;
          isSwiping = false;
          this.track.style.transition = "transform 0.15s ease";
          this.update(this.currentIndex);
        },
        { passive: true },
      );
    }

    setDragOffset(offset: number) {
      const width = this.container.clientWidth;
      const maxIndex = this.track.children.length - 1;

      const draggingPastStart = this.currentIndex === 0 && offset > 0;
      const draggingPastEnd = this.currentIndex === maxIndex && offset < 0;
      const constrainedOffset =
        draggingPastStart || draggingPastEnd ? offset * 0.35 : offset;

      this.track.style.transform = `translateX(${-(this.currentIndex * width) + constrainedOffset}px)`;
    }

    update(index: number) {
      if (index >= this.track.children.length || index < 0) return;

      this.dots[this.currentIndex].removeAttribute("data-active");
      this.dots[this.currentIndex].setAttribute("aria-current", "false");

      this.currentIndex = index;
      this.track.style.transform = `translateX(-${this.currentIndex * 100}%)`;

      this.dots[this.currentIndex].setAttribute("data-active", "");
      this.dots[this.currentIndex].setAttribute("aria-current", "true");

      this.prev.disabled = index == 0;
      this.next.disabled = index == this.track.children.length - 1;
    }
  }

  document.addEventListener("astro:page-load", () => {
    for (const root of document.querySelectorAll("div[data-carousel-root]")) {
      new Carousel(root);
    }
  });
</script>
