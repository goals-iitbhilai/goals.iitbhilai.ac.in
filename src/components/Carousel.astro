---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";
import { parse } from "node-html-parser";

const id = crypto.randomUUID();
const html = await Astro.slots.render("default");
const children = parse(html).children;

type Props = HTMLAttributes<"div">;
const props = Astro.props;
---

<div
  data-carousel-root
  role="region"
  aria-roledescription="carousel"
  {...props}
>
  <div class="relative">
    <!-- Track container -->
    <ul
      data-carousel-track
      tabindex="0"
      class="flex snap-x snap-mandatory overflow-x-auto scroll-smooth"
    >
      {
        children.map((item, index) => (
          <li
            id={`carousel-slide-${index}-${id}`}
            class="w-full shrink-0 snap-center px-2 sm:px-8"
            role="group"
            aria-roledescription="slide"
          >
            <Fragment set:html={item.toString()} />
          </li>
        ))
      }
    </ul>

    <!-- Arrow buttons -->
    <button
      data-carousel-prev
      aria-label="Previous slide"
      class="absolute top-1/2 left-0 -translate-y-1/2 cursor-pointer rounded-full bg-neutral-50 p-2 shadow-sm ring-1 ring-neutral-200 hover:bg-neutral-100 disabled:pointer-events-none disabled:opacity-50 dark:bg-neutral-900 dark:ring-neutral-700 dark:hover:bg-neutral-800"
    >
      <Icon name="lucide:chevron-left" class="size-5" />
    </button>

    <button
      data-carousel-next
      aria-label="Next slide"
      class="absolute top-1/2 right-0 -translate-y-1/2 cursor-pointer rounded-full bg-neutral-50 p-2 shadow-sm ring-1 ring-neutral-200 hover:bg-neutral-100 disabled:pointer-events-none disabled:opacity-50 dark:bg-neutral-900 dark:ring-neutral-700 dark:hover:bg-neutral-800"
    >
      <Icon name="lucide:chevron-right" class="size-5" />
    </button>
  </div>

  <!-- Anchors -->
  <div data-carousel-dots class="mt-6 flex justify-center gap-2">
    {
      Array.from({ length: children.length }).map((_, index) => (
        <button
          aria-label={`Go to slide ${index + 1}`}
          aria-controls={`carousel-slide-${index}-${id}`}
          class="aria-current:bg-secondary-700 aria-current:dark:bg-secondary-400 size-2.5 cursor-pointer rounded-full bg-neutral-300 hover:bg-neutral-500 dark:bg-neutral-700"
        />
      ))
    }
  </div>
</div>

<style>
  ul {
    scrollbar-width: none;
    -ms-overflow-style: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    for (const root of document.querySelectorAll("div[data-carousel-root]")) {
      new Carousel(root);
    }
  });

  class Carousel {
    track: HTMLUListElement;
    prev: HTMLButtonElement;
    next: HTMLButtonElement;
    dots: HTMLDivElement;

    constructor(root: Element) {
      this.track = root.querySelector("[data-carousel-track]")!;
      this.prev = root.querySelector("button[data-carousel-prev]")!;
      this.next = root.querySelector("button[data-carousel-next]")!;
      this.dots = root.querySelector("[data-carousel-dots]")!;

      this.registerObserver();
      this.registerEvents();
    }

    registerObserver() {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const index = Number(entry.target.id.split("-")[2]);

            this.dots.children[index].setAttribute(
              "aria-current",
              entry.isIntersecting.toString(),
            );

            if (entry.isIntersecting) {
              this.prev.disabled = index == 0;
              this.next.disabled = index == this.track.children.length - 1;
            }
          }
        },
        { threshold: 0.5, root: this.track },
      );

      for (const slide of this.track.children) {
        observer.observe(slide);
      }
    }

    registerEvents() {
      this.prev.addEventListener("click", () => {
        this.track.scrollBy({ left: -this.track.clientWidth });
      });

      this.next.addEventListener("click", () => {
        this.track.scrollBy({ left: this.track.clientWidth });
      });

      this.track.addEventListener("keydown", (ev) => {
        if (ev.key === "ArrowLeft") {
          ev.preventDefault();
          this.track.scrollBy({ left: -this.track.clientWidth });
        } else if (ev.key === "ArrowRight") {
          ev.preventDefault();
          this.track.scrollBy({ left: this.track.clientWidth });
        }
      });

      for (let index = 0; index < this.dots.children.length; index++) {
        this.dots.children[index].addEventListener("click", () => {
          this.track.scrollTo({
            left: Math.floor(
              this.track.scrollWidth * (index / this.track.children.length),
            ),
          });
        });
      }
    }
  }
</script>
