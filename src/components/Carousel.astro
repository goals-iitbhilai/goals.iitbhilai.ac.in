---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";
import { parse } from "node-html-parser";

const id = crypto.randomUUID();
const html = await Astro.slots.render("default");
const children = parse(html).children;

type Props = HTMLAttributes<"div">;
const props = Astro.props;
---

<div data-carousel-root role="group" aria-roledescription="carousel" {...props}>
  <div class="relative">
    <!-- Track container -->
    <div data-carousel-container tabindex="0">
      <ul
        data-carousel-track
        class="barwid flex snap-x snap-mandatory overflow-x-auto"
      >
        {
          children.map((item, index) => (
            <li
              id={`carousel-slide-${index}-${id}`}
              class="w-full shrink-0 snap-center px-2 sm:px-8"
              role="group"
              aria-roledescription="slide"
            >
              <Fragment set:html={item.toString()} />
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Arrow buttons -->
    <button
      data-carousel-prev
      aria-label="Previous slide"
      class="absolute top-1/2 left-0 -translate-y-1/2 cursor-pointer rounded-full bg-neutral-50 p-2 shadow-sm ring-1 ring-neutral-200 hover:bg-neutral-100 disabled:pointer-events-none disabled:opacity-50 dark:bg-neutral-900 dark:ring-neutral-700 dark:hover:bg-neutral-800"
    >
      <Icon name="lucide:chevron-left" class="size-5" />
    </button>
    <button
      data-carousel-next
      aria-label="Next slide"
      class="absolute top-1/2 right-0 -translate-y-1/2 cursor-pointer rounded-full bg-neutral-50 p-2 shadow-sm ring-1 ring-neutral-200 hover:bg-neutral-100 disabled:pointer-events-none disabled:opacity-50 dark:bg-neutral-900 dark:ring-neutral-700 dark:hover:bg-neutral-800"
    >
      <Icon name="lucide:chevron-right" class="size-5" />
    </button>
  </div>

  <!-- Anchors -->
  <div class="mt-6 flex justify-center gap-2">
    {
      Array.from({ length: children.length }).map((_, index) => (
        <button
          data-carousel-dot
          aria-label={`Go to slide ${index + 1}`}
          aria-controls={`carousel-slide-${index}-${id}`}
          class="data-active:bg-secondary-700 data-active:dark:bg-secondary-400 size-2.5 cursor-pointer rounded-full bg-neutral-300 hover:bg-neutral-500 dark:bg-neutral-700"
        />
      ))
    }
  </div>
</div>

<style>
  ul {
    scrollbar-width: none;
    -ms-overflow-style: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<script>
  class Carousel {
    currentIndex = 0;

    dots: HTMLButtonElement[];
    track: HTMLUListElement;
    prev: HTMLButtonElement;
    next: HTMLButtonElement;

    constructor(root: Element) {
      this.track = root.querySelector("[data-carousel-track]")!;
      this.prev = root.querySelector("button[data-carousel-prev]")!;
      this.next = root.querySelector("button[data-carousel-next]")!;

      this.prev.addEventListener("click", () => {
        this.update(this.currentIndex - 1);
      });

      this.next.addEventListener("click", () => {
        this.update(this.currentIndex + 1);
      });

      this.dots = this.registerDots(root);
      this.registerEvents(root);
      this.update(0);
    }

    registerDots(root: Element): HTMLButtonElement[] {
      const elements = root.querySelectorAll("[data-carousel-dot]");
      const dots = Array.from(elements) as HTMLButtonElement[];

      for (const [index, dot] of dots.entries()) {
        dot.addEventListener("click", () => {
          this.update(index);
        });
      }

      return dots;
    }

    registerEvents(root: Element) {
      const container = root.querySelector<HTMLDivElement>(
        "[data-carousel-container]",
      )!;

      container.addEventListener("keydown", (ev) => {
        if (ev.key === "ArrowLeft") {
          this.update(this.currentIndex - 1);
        } else if (ev.key === "ArrowRight") {
          this.update(this.currentIndex + 1);
        }
      });
    }

    update(index: number) {
      if (index >= this.track.children.length || index < 0) return;

      this.dots[this.currentIndex].removeAttribute("data-active");
      this.dots[this.currentIndex].setAttribute("aria-current", "false");

      this.currentIndex = index;
      this.track.scrollTo({
        left: Math.floor(
          (this.track.scrollWidth * index) / this.track.children.length,
        ),
        behavior: "smooth",
      });

      this.dots[this.currentIndex].setAttribute("data-active", "");
      this.dots[this.currentIndex].setAttribute("aria-current", "true");

      this.prev.disabled = index == 0;
      this.next.disabled = index == this.track.children.length - 1;
    }
  }

  document.addEventListener("astro:page-load", () => {
    for (const root of document.querySelectorAll("div[data-carousel-root]")) {
      new Carousel(root);
    }
  });
</script>
