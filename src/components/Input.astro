---
import { cn } from "@utils/cn";
import type { HTMLTag, Polymorphic } from "astro/types";

type ValidTags = HTMLTag & ("input" | "textarea" | "select");
type Props<Tag extends ValidTags = "input"> = {
  label?: string;
  labelClass?: string;
} & Polymorphic<{ as: Tag }>;

const {
  as: Tag = "input",
  label = "",
  labelClass = "",
  class: classNames,
  ...rest
} = Astro.props;
---

<label class={cn("w-full", labelClass)}>
  {label}
  <Tag
    class={cn(
      "mt-2 w-full rounded-lg border border-neutral-400 bg-neutral-50/25 p-3 hover:bg-neutral-100/25 dark:border-neutral-600 dark:bg-neutral-900 dark:hover:bg-neutral-800",
      classNames,
    )}
    {...rest}
  >
    <slot />
  </Tag>
</label>
