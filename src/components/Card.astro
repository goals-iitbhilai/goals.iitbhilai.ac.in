---
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag = "div"> = {
  kind?: "primary" | "normal" | "subtle";
} & Polymorphic<{ as: Tag }>;

const {
  as: Tag = "div",
  kind = "normal",
  class: className,
  ...rest
} = Astro.props;
---

<Tag
  class:list={[
    "rounded-xl bg-neutral-300/5 p-8 shadow-sm/2 backdrop-blur-md dark:bg-white/5",
    {
      primary:
        "dark:border-primary-500 border-secondary-500 border-2 dark:border",
      normal: "border border-neutral-300 dark:border-neutral-600",
      subtle: "border border-neutral-200 dark:border-neutral-700",
    }[kind],
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
