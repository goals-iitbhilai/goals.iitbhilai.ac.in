---
import BaseLayout from "./BaseLayout.astro";
import Blob from "@components/Blob.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="fixed -z-1 h-full w-full" aria-hidden="true">
    <Blob
      class="left-1/2 w-5xl -translate-x-1/4 opacity-50 blur-3xl dark:opacity-25"
      transform="translate(450 0)"
      pathClass="text-secondary-500 dark:text-primary-500"
    />
    <Blob
      class="bottom-1/2 left-0 w-2xl translate-y-1/2 opacity-50 blur-3xl dark:opacity-25"
      transform="translate(0 450)"
      pathClass="text-primary-500 dark:text-secondary-500"
    />
    <Blob
      class="right-0 bottom-0 w-xl opacity-50 blur-3xl dark:opacity-25"
      transform="translate(900 450)"
      pathClass="text-primary-500 dark:text-secondary-500"
    />
  </div>

  <!-- Hero -->
  <section class="px-8 py-16">
    <div class="mx-auto flex flex-col items-center gap-8 text-balance md:w-216">
      <h1 class="text-center text-6xl font-bold dark:text-white">
        {title}
      </h1>
      <p class="max-w-prose text-center text-xl font-light">
        {description}
      </p>
    </div>
  </section>

  <slot />
</BaseLayout>
