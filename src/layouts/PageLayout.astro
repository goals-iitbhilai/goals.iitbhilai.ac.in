---
import BaseLayout from "./BaseLayout.astro";
import { getEntry } from "astro:content";
import { normalize } from "@utils/path";

const entry = await getEntry("pages", normalize(Astro.url.pathname));
const { title, description } = entry!.data;
---

<BaseLayout>
  <section class="px-8 py-16">
    <div class="mx-auto flex flex-col items-center gap-8 text-balance md:w-216">
      <h1 class="text-center text-6xl font-bold dark:text-white">
        {title}
      </h1>
      <p class="max-w-prose text-center text-xl font-light">
        {description}
      </p>
    </div>
  </section>

  <slot />
</BaseLayout>
