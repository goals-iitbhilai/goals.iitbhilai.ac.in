---
import BaseLayout from "./BaseLayout.astro";
import { getEntry } from "astro:content";
import { normalize } from "@utils/path";

const entry = await getEntry("pages", normalize(Astro.url.pathname));
const { title, description } = entry!.data;
---

<BaseLayout>
  <div class="fixed -z-1 h-full w-full">
    <svg
      viewBox="0 0 900 600"
      class="absolute left-1/2 w-5xl -translate-x-1/4 opacity-50 blur-3xl dark:opacity-25"
      fill="currentColor"
    >
      <g transform="translate(450 0)">
        <path
          d="M122 -142.9C169.6 -133.4 227.4 -113 238.9 -77.6C250.4 -42.2 215.6 8.2 193.1 58.2C170.6 108.2 160.5 157.6 130.4 192.5C100.3 227.4 50.2 247.7 10.4 233.4C-29.4 219.1 -58.8 170.2 -95.6 137.5C-132.3 104.8 -176.5 88.2 -206.5 53.5C-236.5 18.7 -252.3 -34.2 -239.8 -79.5C-227.2 -124.7 -186.2 -162.3 -141.5 -172.7C-96.8 -183.2 -48.4 -166.6 -5.6 -158.9C37.2 -151.2 74.5 -152.5 122 -142.9"
          class="text-secondary-500 dark:text-primary-500"></path>
      </g>
    </svg>
    <svg
      viewBox="0 0 900 600"
      class="absolute bottom-1/2 left-0 w-2xl translate-y-1/2 opacity-50 blur-3xl dark:opacity-25"
      fill="currentColor"
    >
      <g transform="translate(0 450)">
        <path
          d="M122 -142.9C169.6 -133.4 227.4 -113 238.9 -77.6C250.4 -42.2 215.6 8.2 193.1 58.2C170.6 108.2 160.5 157.6 130.4 192.5C100.3 227.4 50.2 247.7 10.4 233.4C-29.4 219.1 -58.8 170.2 -95.6 137.5C-132.3 104.8 -176.5 88.2 -206.5 53.5C-236.5 18.7 -252.3 -34.2 -239.8 -79.5C-227.2 -124.7 -186.2 -162.3 -141.5 -172.7C-96.8 -183.2 -48.4 -166.6 -5.6 -158.9C37.2 -151.2 74.5 -152.5 122 -142.9"
          class="dark:text-secondary-500 text-primary-500"></path>
      </g>
    </svg>
    <svg
      viewBox="0 0 900 600"
      class="absolute right-0 bottom-0 w-xl opacity-50 blur-3xl dark:opacity-25"
      fill="currentColor"
    >
      <g transform="translate(900 450)">
        <path
          d="M122 -142.9C169.6 -133.4 227.4 -113 238.9 -77.6C250.4 -42.2 215.6 8.2 193.1 58.2C170.6 108.2 160.5 157.6 130.4 192.5C100.3 227.4 50.2 247.7 10.4 233.4C-29.4 219.1 -58.8 170.2 -95.6 137.5C-132.3 104.8 -176.5 88.2 -206.5 53.5C-236.5 18.7 -252.3 -34.2 -239.8 -79.5C-227.2 -124.7 -186.2 -162.3 -141.5 -172.7C-96.8 -183.2 -48.4 -166.6 -5.6 -158.9C37.2 -151.2 74.5 -152.5 122 -142.9"
          class="dark:text-secondary-500 text-primary-500"></path>
      </g>
    </svg>
  </div>

  <!-- Hero -->
  <section class="px-8 py-16">
    <div class="mx-auto flex flex-col items-center gap-8 text-balance md:w-216">
      <h1 class="text-center text-6xl font-bold dark:text-white">
        {title}
      </h1>
      <p class="max-w-prose text-center text-xl font-light">
        {description}
      </p>
    </div>
  </section>

  <slot />
</BaseLayout>
