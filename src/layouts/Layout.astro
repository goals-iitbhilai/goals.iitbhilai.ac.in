---
import Header from "@components/Header/Header.astro";
import Footer from "@components/Footer.astro";
import { Font } from "astro:assets";
import "../global.css";
import { getAbsoluteURL, getURL } from "@utils/url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "GOALS",
  description = "General Oratory and Literacy Society, IIT Bhilai",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href={getURL("/favicon.svg")} />
    <link rel="icon" href={getURL("/favicon.ico")} />
    <!-- Fonts -->
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-crimson" />
    <!-- Metadata -->

    <meta name="darkreader-lock" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={getAbsoluteURL(Astro.url.pathname)} />

    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body
    class="bg-neutral-50 text-neutral-700 dark:bg-neutral-950 dark:text-neutral-300"
  >
    <Header />
    <main>
      <div class="h-16.25"></div>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    transition: all 0.15s ease-in-out;
  }
</style>
